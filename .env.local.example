# n8n-sandbox: run-time secrets template.
#
# Copy to .env.local (gitignored), fill in the value, encrypt it in place:
#   ansible-vault encrypt --vault-password-file collateral/vault-pass.sh .env.local
# Load it into the shell before running scripts or Claude Code:
#   if decrypted_env=$(ansible-vault decrypt --vault-password-file collateral/vault-pass.sh --output - .env.local); then
#       source /dev/stdin <<< "$decrypted_env"
#   fi
#   unset decrypted_env
#
# Format: every line is `export KEY="value"`, so `source` works.

# --- n8n public API ---------------------------------------------------------
# Created in the n8n UI: Settings → n8n API → Create an API key (shown once).
# Scripts read it from the environment and pass it to curl on stdin.
export N8N_API_KEY="REPLACE-ME"
